#!/usr/bin/env node
import fs from 'fs';
import path from 'path';

const dummyCanvas = {
  id: 'canvas',
  style: { cursor: '' },
  getContext: () => null,
  addEventListener: () => {},
  removeEventListener: () => {},
  getBoundingClientRect: () => ({ left: 0, top: 0, width: 1280, height: 720 }),
};

globalThis.window = globalThis.window || {
  AudioContext: class {},
  webkitAudioContext: class {},
  addEventListener: () => {},
  removeEventListener: () => {},
  devicePixelRatio: 1,
};
globalThis.document = globalThis.document || {
  createElement: () => dummyCanvas,
  getElementById: () => dummyCanvas,
  body: { appendChild: () => {}, removeChild: () => {} },
};

const rootDir = '/home/user/Last-Harbord';
let wasmPath = path.join(rootDir, 'vendor/godot/godot.web.template_release.wasm32.nothreads.wasm');
let jsModulePath = path.join(rootDir, 'vendor/godot/godot.web.template_release.wasm32.nothreads.js');

if (!fs.existsSync(wasmPath) || !fs.existsSync(jsModulePath)) {
  wasmPath = path.join(rootDir, 'node_modules/@ringozz/godot-web-wasm32/gen/godot.web.template_release.wasm32.nothreads.wasm');
  jsModulePath = path.join(rootDir, 'node_modules/@ringozz/godot-web-wasm32/gen/godot.web.template_release.wasm32.nothreads.js');
}

if (!fs.existsSync(wasmPath) || !fs.existsSync(jsModulePath)) {
  console.error('[godot] Error: Godot WASM engine binaries not found in vendor/godot or node_modules.');
  process.exit(1);
}

const wasmBinary = fs.readFileSync(wasmPath);
const mod = await import(jsModulePath);
const godotFactory = mod.default;

const rawArgs = process.argv.slice(2);
const args = [...rawArgs];
if (!args.includes('--headless')) {
  args.unshift('--headless');
}

// Check if a project path is specified
let projectDir = null;
const pathIdx = args.indexOf('--path');
if (pathIdx !== -1 && pathIdx + 1 < args.length) {
  projectDir = path.resolve(args[pathIdx + 1]);
} else if (fs.existsSync(path.join(rootDir, 'godot_project/project.godot'))) {
  projectDir = path.resolve(rootDir, 'godot_project');
} else if (fs.existsSync('project.godot')) {
  projectDir = path.resolve('.');
}

process.on('uncaughtException', (err) => {
  if (err && (err.name === 'ExitStatus' || typeof err.status === 'number')) {
    process.exit(err.status || 0);
  }
  console.error(err);
  process.exit(1);
});

const godot = await godotFactory({
  wasmBinary,
  noInitialRun: true,
  quit_: (status) => {
    process.exit(status || 0);
  },
  print: (text) => console.log(text),
  printErr: (text) => {
    if (!text.includes('ExitStatus') && !text.includes('Program terminated')) {
      console.error(text);
    }
  },
});

godot.initConfig({ canvas: dummyCanvas });

// If projectDir exists, sync its files into the Godot virtual filesystem at /
if (projectDir && fs.existsSync(projectDir)) {
  function copyDirToFS(dir, base = '') {
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      const full = path.join(dir, entry.name);
      const rel = base ? `${base}/${entry.name}` : entry.name;
      if (entry.isDirectory()) {
        copyDirToFS(full, rel);
      } else {
        const bytes = fs.readFileSync(full);
        godot.copyToFS('/' + rel, bytes);
      }
    }
  }
  copyDirToFS(projectDir);

  // If path argument was passed, point it to /
  if (pathIdx !== -1) {
    args[pathIdx + 1] = '/';
  } else {
    args.push('--path', '/');
  }
}

try {
  godot.callMain(args);
  process.exit(0);
} catch (err) {
  if (err && (err.name === 'ExitStatus' || typeof err.status === 'number')) {
    process.exit(err.status || 0);
  }
  throw err;
}
