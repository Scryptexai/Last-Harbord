[node name="NPC_Fisherman" parent="Village" instance=ExtResource("6_npc")]
transform = Transform3D(0.866025, 0, -0.5, 0, 1, 0, 0.5, 0, 0.866025, -3.8, 0, 1.5)
npc_name = "Pak Hasan"
role = "Nelayan Tua"
dialogue = "Laut sekarang sedang aneh, anak muda. Saat pasang tinggi datang, zombie di pulau-pulau luar menjadi sangat agresif. Jangan terlambat pulang ke perahu."

[node name="NPC_Medic" parent="Village" instance=ExtResource("6_npc")]
